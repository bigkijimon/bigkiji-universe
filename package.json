{
  "name": "bigkiji-universe",
  "version": "2.5.0",
  "description": "BigKiji Universe OS — menu-bar orchestration synapse app",
  "author": "BigKiji Universe Contributors",
  "main": "src/core/main.js",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "bigkiji": "./tools/bigkiji",
    "Bigkiji": "./tools/bigkiji",
    "kiji": "./tools/bigkiji",
    "Kiji": "./tools/bigkiji"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --show-main",
    "dev:console": "electron . --show-console",
    "dist": "node tools/build-host.js",
    "dist:mac": "APPLE_KEYCHAIN_PROFILE=BigKijiNotary electron-builder --mac dmg zip --arm64 --x64",
    "dist:local": "electron-builder --mac --dir --arm64 -c.mac.identity=\"BigKiji Universe Dev Signer\" -c.mac.notarize=false -c.mac.forceCodeSigning=false",
    "dist:win": "electron-builder --win nsis zip --x64 --arm64",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --arm64",
    "dist:dir": "electron-builder --mac --dir --arm64",
    "check:imports": "node tools/import-selftest.js",
    "verify:release": "node tools/verify-macos-release.js",
    "test:governance": "node tools/governance-selftest.js",
    "test:cost-policy": "node tools/cost-policy-selftest.js",
    "test:fast-router": "node tools/fast-router-selftest.js",
    "test:particle-cluster": "node tools/particle-cluster-selftest.js",
    "test:ui-3d": "node tools/ui-3d-selftest.js",
    "test:interaction": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/interaction-selftest.mjs",
    "test:terminal-resizer": "node tools/terminal-resizer-selftest.js",
    "test:radial-spark": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/radial-spark-selftest.mjs",
    "test:comfy": "node tools/comfy-bridge-selftest.js",
    "test:telemetry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/telemetry-store-selftest.mjs",
    "test:cli-theme": "node tools/cli-theme-selftest.js",
    "test:architecture": "node tools/architecture-selftest.js",
    "test:runtime-policy": "node tools/runtime-policy-selftest.js",
    "test:voice-engine": "node tools/voice-engine-selftest.js",
    "test:cmux": "node tools/cmux-bridge-selftest.js",
    "test:context": "node tools/context-routing-selftest.js",
    "test:pi-core": "node scripts/test-pi-core.js",
    "test:preview": "node tools/preview-server-selftest.js",
    "test:daemon": "node tools/daemon-selftest.js",
    "test:security": "node tools/security-selftest.js",
    "test:conversation": "node tools/conversation-selftest.js",
    "test:audio-wave": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/audio-wave-selftest.js",
    "test:tools": "node tools/tool-registry-selftest.js",
    "test": "npm run check:imports && npm run test:architecture && npm run test:runtime-policy && npm run test:voice-engine && npm run test:cmux && npm run test:context && npm run test:security && npm run test:routing && npm run test:deliberation && npm run test:conversation && npm run test:malformed && npm run test:paste && npm run test:gpu-residency && npm run test:pi-core && npm run test:preview && npm run test:daemon && npm run test:assets && npm run test:governance && npm run test:cost-policy && npm run test:fast-router && npm run test:particle-cluster && npm run test:ui-3d && npm run test:interaction && npm run test:terminal-resizer && npm run test:radial-spark && npm run test:audio-wave && npm run test:comfy && npm run test:telemetry && npm run test:workspaces && npm run test:watch-queue && npm run test:markdown && npm run test:embeddings && npm run test:gpu-scheduler && npm run test:app-menu && npm run test:text-index && npm run test:console && npm run test:skills && npm run test:tools && npm run test:provider-readiness && npm run test:circuit-breaker && npm run test:cli-render && npm run test:cli-theme",
    "audit:delegations": "node tools/delegation-audit.js",
    "index:memory": "node tools/index-system-memory.js",
    "postinstall": "node tools/postinstall.js",
    "test:skills": "node tools/skill-registry-selftest.js",
    "test:workspaces": "node tools/workspace-registry-selftest.js",
    "test:cli-render": "node tools/cli-render-selftest.js",
    "test:routing": "node tools/routing-learning-selftest.js",
    "test:deliberation": "node tools/deliberation-selftest.js",
    "test:assets": "node tools/assets-route-selftest.js",
    "test:watch-queue": "node tools/watch-queue-selftest.js",
    "test:markdown": "node tools/markdown-selftest.js",
    "test:embeddings": "node tools/embedding-store-selftest.js",
    "test:gpu-scheduler": "node tools/gpu-scheduler-selftest.js",
    "test:app-menu": "node tools/app-menu-selftest.js",
    "test:text-index": "node tools/text-index-selftest.js",
    "test:console": "node tools/console-window-selftest.js",
    "test:circuit-breaker": "node tools/circuit-breaker-selftest.js",
    "test:provider-readiness": "node tools/provider-readiness-selftest.js",
    "test:malformed": "node tools/malformed-input-selftest.js",
    "test:paste": "node tools/paste-turn-selftest.js",
    "test:gpu-residency": "node tools/gpu-residency-selftest.js"
  },
  "build": {
    "appId": "com.bigkiji.universe",
    "productName": "BigKiji Universe",
    "directories": {
      "output": "../dist"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "**/*",
      "!**/.env",
      "!recordings/**",
      "!graphify-out/**",
      "!**/*.bak-*",
      "!**/*.bak",
      "!fixtures/**",
      "!tools/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "forceCodeSigning": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "BigKiji Universe uses the microphone only for owner-directed local voice conversations."
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.iconset/icon_512x512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.iconset"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^11.0.7",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "three": "^0.172.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
