#!/bin/sh
# bigkiji — BigKiji Universe CLI wrapper.
#
# POSIX sh, not zsh. This is the command other tools run: cmux, tmux, a shell
# && chain and a CI image all have /bin/sh, and zsh's ${0:A} was convenient at
# the cost of every environment that does not ship zsh.
#
# The loop below is what ${0:A} was doing — follow symlinks to the real file so
# that `npm link` and a hand-made symlink on PATH both resolve to this checkout.
#
# The depth limit is not decoration: a symlink cycle anywhere on PATH would
# otherwise spin this loop forever instead of failing, which ${0:A} could not do.
self=$0
depth=0
while [ -L "$self" ]; do
  depth=$((depth + 1))
  if [ "$depth" -gt 40 ]; then
    echo "bigkiji: symlink loop resolving $0" >&2
    exit 1
  fi
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
exec node "$(cd "$(dirname "$self")" && pwd)/bigkiji-cli.js" "$@"
