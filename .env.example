# BigKiji Universe — environment reference (no secrets in this repo).
# The app itself needs no env vars. The Pi core (pi CLI) reads the Google key
# from your login shell; the packaged .app backfills it via `zsh -lc` at start.

# Gemini API key for the Pi core fallback chain + swarm discussion (REST).
# Set in ~/.zshrc, NOT here:
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # alternative name, either works

# ---- optional toggles ----
# BIGKIJI_AUTOHEAL=0         # disable Auto-Heal repair-task generation
# BIGKIJI_SWARM=0            # disable task classification (cache/swarm) routing
# SELFTEST_MODEL=google/gemini-3.1-flash-lite  # model for tools/selftest.js

# ---- test harnesses (dev only) ----
# SMOKE=1                    # boot check, exits ~4s with SMOKE OK/FAIL
# SNAP=<dir>                 # screenshot both windows after 5s, then exit
# PITEST="<prompt>" PITEST_MARKER=<token>  # pipeline E2E with marker round-trip
# VOICETEST=1                # speak a test line at startup
# TTSTEST=1                  # sentence-streaming TTS + barge-in kill harness
