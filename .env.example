# BigKiji Universe — copy to .env and fill only the services you use.
# Never commit .env. API keys are optional; local Qwen remains the default.

# Authorized paid execution providers (the only cloud providers BigKiji may call)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # Codex only; never used for TTS
GEMINI_API_KEY=
ZAI_API_KEY=             # GLM

# Portable data roots. Blank values use OS-safe defaults.
# APP_ROOT/UI_ROOT are advanced overrides for non-standard packaged layouts.
APP_ROOT=
UI_ROOT=
BIGKIJI_VAULT_ROOT=
BIGKIJI_KNOWLEDGE_ROOT=
# KNOWLEDGE_ROOT= is accepted as a compatibility alias.
GRAPHIFY_GRAPH_PATH=

# Local planning and speech
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen3.5:35b-a3b
QWEN_TTS_URL=http://127.0.0.1:17890
PYTHON_BIN=
ESPEAK_BIN=              # Linux system-voice fallback (optional)

# Optional local integrations
CMUX_BIN=                # macOS only, e.g. /opt/homebrew/bin/cmux
COMFYUI_ROOT=
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_PORT=8188
WHISPER_BIN=
WHISPER_MODEL=

# Optional executor binary overrides
CLAUDE_BIN=
CODEX_BIN=
GEMINI_BIN=
PI_BIN=

# Runtime toggles
BIGKIJI_AUTOHEAL=1
BIGKIJI_SWARM=1
BIGKIJI_SHOW_MAIN=0
